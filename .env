# =============================================================================
# FORGE INDIA CONNECT (FIC) - CLOUD & ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains all environment variables, cloud database URIs, API keys,
# cloud storage credentials, and service tokens required by the application.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION & RUNTIME ENVIRONMENT
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=FIC_Territory_Operations_Manager
APP_VERSION=1.0.0
APP_PUBLIC_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1
SOCKET_URL=http://localhost:3000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 2. AUTHENTICATION, JWT & SECURITY SECRETS
# -----------------------------------------------------------------------------
JWT_SECRET=fic_jwt_secure_enterprise_secret_key_2026_cloud_auth
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=fic_jwt_refresh_enterprise_secret_key_2026
OTP_SALT_SECRET=fic_otp_cryptographic_salt_token_2026
API_ENCRYPTION_KEY=fic_aes256_cloud_encryption_key_2026
SESSION_SECRET=fic_session_cookie_vault_key_2026

# -----------------------------------------------------------------------------
# 3. CLOUD DATABASE & PERSISTENCE (MongoDB Atlas / PostgreSQL / Supabase)
# -----------------------------------------------------------------------------
# MongoDB Atlas Connection Strings
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/fic_operations?retryWrites=true&w=majority&appName=FICCluster
MONGODB_ATLAS_URL=mongodb+srv://fic_admin:FicPassword2026@cluster0.abcde.mongodb.net/fic_operations?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://fic_cloud_admin:FicCloudPass2026@fic-cluster.mongodb.net/fic_operations?retryWrites=true&w=majority

# Alternative PostgreSQL / Supabase connection:
# DATABASE_URL=postgresql://postgres:FicCloudPass2026@db.fic-cluster.supabase.co:5432/fic_operations?sslmode=require

DB_HOST=cluster0.abcde.mongodb.net
DB_PORT=27017
DB_NAME=fic_operations
DB_USER=fic_admin
DB_PASSWORD=FicPassword2026
DB_SSL=true

# -----------------------------------------------------------------------------
# 4. CLOUD CACHE & RATE LIMITING (Redis / Upstash Cloud Redis)
# -----------------------------------------------------------------------------
REDIS_URL=redis://default:FicRedisCloud2026@fic-redis.cloud.redislabs.com:6379
UPSTASH_REDIS_REST_URL=https://fic-cloud-redis-upstash.io
UPSTASH_REDIS_REST_TOKEN=AXhxASQgYTM0MTBkZTYtNDM3Yy00OGJjLWJkYjItMzFiMzA3NzQzNDVh

# -----------------------------------------------------------------------------
# 5. CLOUD STORAGE - AWS S3 (Photos, Voice Memos, PDF/Excel Exports)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=fic-operations-cloud-storage
AWS_S3_CUSTOM_DOMAIN=https://cdn.forgeindia.in
AWS_S3_FORCE_PATH_STYLE=false

# -----------------------------------------------------------------------------
# 6. CLOUD STORAGE - CLOUDINARY (Media CDN & Image Optimization)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=forge-india-connect
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz12345@forge-india-connect

# -----------------------------------------------------------------------------
# 7. CLOUD STORAGE - SUPABASE STORAGE (Alternative Cloud Bucket)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://xyzproject.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key
SUPABASE_STORAGE_BUCKET=fic-field-assets

# -----------------------------------------------------------------------------
# 8. CLOUD SMS & OTP GATEWAY PROVIDERS
