{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true
  },
  "gradle.autoDetect": "off",
  "gradle.nestedProjects": false,
  "gradle.projectOpenStrategy": "open",
  "java.import.gradle.enabled": false,
  "java.import.gradle.autoReload.enabled": false
}
